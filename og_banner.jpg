@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  body {
    @apply bg-[#050811] text-slate-100 font-sans antialiased overflow-x-hidden;
  }
}

/* Electric Blue Gradient & Glass Utilities */
.text-gradient-brand {
  background: linear-gradient(135deg, #38bdf8 0%, #2563eb 50%, #6366f1 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.text-gradient-electric {
  background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 50%, #0284c7 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.glass-card {
  background: rgba(10, 16, 30, 0.65);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.glass-card-hover {
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.glass-card-hover:hover {
  background: rgba(15, 24, 45, 0.85);
  border-color: rgba(56, 189, 248, 0.4);
  box-shadow: 0 10px 30px -10px rgba(37, 99, 235, 0.25);
  transform: translateY(-2px);
}

/* Interactive Gentle Shake Animation for "Unirme ahora" Button */
@keyframes gentle-shake {
  0%, 80%, 100% { transform: scale(1) rotate(0deg); }
  85% { transform: scale(1.04) rotate(-2.5deg); }
  90% { transform: scale(1.04) rotate(2.5deg); }
  95% { transform: scale(1.04) rotate(-1.5deg); }
}

.animate-gentle-shake {
  animation: gentle-shake 3.5s cubic-bezier(0.36, 0.07, 0.19, 0.97) infinite;
}

/* Reactive Aurora Boreal Background Animations */
@keyframes aurora-float-1 {
  0%, 100% { transform: translate(-10%, -10%) scale(1) rotate(0deg); opacity: 0.45; }
  50% { transform: translate(15%, 18%) scale(1.25) rotate(180deg); opacity: 0.75; }
}

@keyframes aurora-float-2 {
  0%, 100% { transform: translate(15%, -15%) scale(1.2) rotate(0deg); opacity: 0.35; }
  50% { transform: translate(-12%, 12%) scale(0.95) rotate(-120deg); opacity: 0.65; }
}

@keyframes aurora-float-3 {
  0%, 100% { transform: translate(-12%, 12%) scale(0.9) rotate(0deg); opacity: 0.5; }
  50% { transform: translate(12%, -18%) scale(1.3) rotate(90deg); opacity: 0.35; }
}

.aurora-container {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
  background: #040711;
}

.aurora-wave-1 {
  position: absolute;
  top: -15%;
  left: 5%;
  width: 65vw;
  height: 65vw;
  background: radial-gradient(circle, rgba(56, 189, 248, 0.25) 0%, rgba(37, 99, 235, 0.16) 45%, transparent 70%);
  filter: blur(100px);
  animation: aurora-float-1 20s ease-in-out infinite;
}

.aurora-wave-2 {
  position: absolute;
  top: 35%;
  right: -10%;
  width: 55vw;
  height: 55vw;
  background: radial-gradient(circle, rgba(99, 102, 241, 0.22) 0%, rgba(2, 132, 199, 0.15) 50%, transparent 70%);
  filter: blur(110px);
  animation: aurora-float-2 24s ease-in-out infinite;
}

.aurora-wave-3 {
  position: absolute;
  bottom: -15%;
  left: 15%;
  width: 60vw;
  height: 60vw;
  background: radial-gradient(circle, rgba(3, 105, 161, 0.2) 0%, rgba(124, 58, 237, 0.12) 50%, transparent 70%);
  filter: blur(120px);
  animation: aurora-float-3 28s ease-in-out infinite;
}

/* Custom Scrollbar */
::-webkit-scrollbar {
  width: 8px;
}
::-webkit-scrollbar-track {
  background: #050811;
}
::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 4px;
}
::-webkit-scrollbar-thumb:hover {
  background: rgba(56, 189, 248, 0.5);
}
